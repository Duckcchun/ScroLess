# ScroLess 백엔드 환경변수 예시
#
# 실제 사용 시 이 파일을 복사해 .env 로 만들고 값을 채우세요.
#   cp .env.example .env
#
# .env 파일은 .gitignore 에 의해 깃에 올라가지 않습니다.
# API 키는 이 .env 파일에만 넣고, 절대 코드나 채팅/커밋에 노출하지 마세요.

# Google AI Studio(aistudio.google.com)에서 발급한 Gemini API 키
GEMINI_API_KEY=여기에_발급받은_새_키를_넣으세요

# 사용할 Gemini 모델
# 참고: 신규 API 계정은 Gemini 3.x 세대만 사용할 수 있습니다 (2.5 계열은 신규 사용자 접근 불가).
#   저비용/고속: gemini-3.6-flash  (권장 기본값)
#   더 저렴:     gemini-3.5-flash-lite
#   고정밀:      gemini-3.1-pro-preview
# 계정에서 사용 가능한 모델 목록 확인:
#   GET https://generativelanguage.googleapis.com/v1beta/models?key=YOUR_KEY
GEMINI_MODEL=gemini-3.6-flash

# 서버 포트
PORT=8787
